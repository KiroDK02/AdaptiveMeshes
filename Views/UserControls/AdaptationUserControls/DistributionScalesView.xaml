<UserControl x:Class="Views.UserControls.AdaptationUserControls.DistributionScalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Views.UserControls.AdaptationUserControls"
             xmlns:adaptationVms="clr-namespace:ViewModels.AdaptationViewModels;assembly=ViewModels"
             xmlns:adaptationViews="clr-namespace:Views.UserControls.AdaptationUserControls"
             xmlns:converters="clr-namespace:Views.Converters"
             d:DataContext="{d:DesignInstance Type=adaptationVms:DistributionScalesViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Expander IsExpanded="False">
        
        <Expander.Header>
            <TextBlock>
                <Run Text="Шкалы (активная: "/>
                <Run Text="{Binding ActiveScale.Name, FallbackValue=нет активной}"/>
                <Run Text=")"/>
            </TextBlock>
        </Expander.Header>
        
        <StackPanel Margin="10,5,0,5">
            
            <ItemsControl ItemsSource="{Binding Scales}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type adaptationVms:DistributionScaleViewModel}">
                        <adaptationViews:DistributionScaleView DataContext="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <Button Content="Добавить шкалу"
                    Command="{Binding AddScaleCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0"/>
            
        </StackPanel>
    </Expander>
</UserControl>
