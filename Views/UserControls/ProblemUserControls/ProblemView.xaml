<UserControl x:Class="Views.UserControls.ProblemUserControls.ProblemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewsProblem="clr-namespace:Views.UserControls.ProblemUserControls"
             xmlns:viewsAdaptation="clr-namespace:Views.UserControls.AdaptationUserControls"
             xmlns:viewsMaterials="clr-namespace:Views.UserControls.MaterialsUserControls"
             xmlns:vm="clr-namespace:ViewModels.ProblemViewModels;assembly=ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ProblemViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Expander Header="{Binding ProblemName}"
              Margin="0,0,0,5"
              IsExpanded="True">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0"
                     Text="{Binding ProblemName, Mode=TwoWay}"
                     Margin="0,0,0,5" />

            <ComboBox Grid.Row="1"
                      ItemsSource="{Binding Source={x:Static vm:ProblemTypeHelper.Values}}"
                      SelectedItem="{Binding SelectedProblemType}" />

            <viewsProblem:MeshView Grid.Row="2" 
                                   DataContext="{Binding MeshViewModel}"
                                   Margin=" 10, 10, 0, 10"/>
 
            <viewsMaterials:MaterialsView Grid.Row="3"
                                          DataContext="{Binding Materials}"
                                          Margin="10,0,0,10" />

            <viewsAdaptation:AdaptationView Grid.Row="4"
                                            DataContext="{Binding Adaptation}"
                                            Margin="10,0,0,10" />

            <viewsProblem:SolutionPointsView Grid.Row="5"
                                             DataContext="{Binding SolutionPoints}"
                                             Margin="10,0,0,10" />

            <viewsProblem:ErrorCalculationView Grid.Row="6"
                                               DataContext="{Binding ErrorCalculation}"
                                               Margin="10,0,0,5" />
            
            <Grid Grid.Row="7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0"
                             Rows="2" Columns="2"
                             Margin="0,5,0,0">
                    <Button Content="Построить"
                            Command="{Binding BuildProblemCommand}"
                            Margin="0,0,2,2" />
                    <Button Content="Адаптировать сетку"
                            Command="{Binding AdaptMeshCommand}"
                            Margin="2,0,0,2" />
                    <Button Content="Решить"
                            Command="{Binding SolveProblemCommand}"
                            Margin="0,2,2,0" />
                    <Button Content="Сброс решения"
                            Command="{Binding ResetSolutionCommand}"
                            IsEnabled="{Binding ProblemSolved}"
                            Margin="2,2,0,0"/>
                </UniformGrid>

                <Button Grid.Row="1" Content="Отрисовать решение"
                        Command="{Binding DrawSolutionCommand}"
                        IsEnabled="{Binding ProblemSolved}"
                        Margin="0,4,0,0" />
                
                <Button Grid.Row="2"
                        Content="Сохранить проблему"
                        Command="{Binding SaveProblemToFileCommand}"
                        Margin="0,4,0,0" />
            </Grid>
        </Grid>
    </Expander>
</UserControl>