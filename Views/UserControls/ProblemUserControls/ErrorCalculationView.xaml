<UserControl x:Class="Views.UserControls.ProblemUserControls.ErrorCalculationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Views.UserControls.ProblemUserControls"
             xmlns:problemVms="clr-namespace:ViewModels.ProblemViewModels;assembly=ViewModels"
             xmlns:converters="clr-namespace:Views.Converters"
             d:DataContext="{d:DesignInstance Type=problemVms:ErrorCalculationViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <converters:NanToVisibilityConverter x:Key="NanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Expander Header="Погрешность"
              IsExpanded="False">
        <StackPanel Margin="10,5,0,5">
            
            <TextBlock Text="Способ вычисления погрешности"
                       Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding 
                                        Source={x:Static problemVms:ErrorTypeHelper.Values}}"
                      SelectedItem="{Binding ErrorType}"
                      Margin="0,0,0,8">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding 
                                Converter={StaticResource EnumDescriptionConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            
            <StackPanel Visibility="{Binding ErrorType,
                                Converter={StaticResource EnumToVisibilityConverter},
                                ConverterParameter={x:Static problemVms:ErrorType.FromDesiredSolution}}">
                <TextBlock Text="Искомое решение"
                           Margin="0,0,0,5"/>
                <TextBox Text="{Binding RealSolution, Mode=TwoWay}"
                         Margin="0,0,0,8"/>
                
                <UniformGrid Rows="1" Columns="2">
                    <Button Content="Рассчитать погрешность"
                            Command="{Binding CalculateErrorFromRealSolutionCommand}"
                            Margin="0,0,5,0"/>
                    <Button Content="Сбросить погрешность"
                            Command="{Binding ResetErrorValueCommand}"/>
                </UniformGrid>
            </StackPanel>
            
            <StackPanel Visibility="{Binding ErrorType,
                                Converter={StaticResource EnumToVisibilityConverter},
                                ConverterParameter={x:Static problemVms:ErrorType.FromOtherSolution}}">
                <TextBlock Text="От решения проблемы"
                           Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding AllProblems}"
                          SelectedItem="{Binding SelectedOtherProblem}"
                          DisplayMemberPath="ProblemName"
                          Margin="0,0,0,8"/>
                
                <UniformGrid Rows="1" Columns="2">
                    <Button Content="Рассчитать погрешность"
                            Command="{Binding CalculateErrorFromOtherSolutionCommand}"
                            Margin="0,0,5,0"/>
                    <Button Content="Сбросить погрешность"
                            Command="{Binding ResetErrorValueCommand}"/>
                </UniformGrid>
            </StackPanel>
            
            <TextBlock Visibility="{Binding ErrorValue,
                            Converter={StaticResource NanToVisibilityConverter}}"
                       Margin="0,8,0,0">
                <Run Text="Погрешность: "/>
                <Run Text="{Binding ErrorValue, StringFormat={}{0:E4}}"/>
            </TextBlock>
            
        </StackPanel>
    </Expander>
    
</UserControl>
