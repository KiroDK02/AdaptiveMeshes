<UserControl x:Class="Views.UserControls.MaterialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:Views.UserControls"
             xmlns:vm="clr-namespace:ViewModels.MaterialViewModels;assembly=ViewModels"
             xmlns:converters="clr-namespace:Views.Converters"
             d:DataContext="{d:DesignInstance Type=vm:MaterialsViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:NullToBoolConverter x:Key="NullToBool" />
    </UserControl.Resources>
    
    <Expander Header="Материалы">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <UniformGrid Grid.Row="0" 
                         Columns="2"
                         Margin="0,0,0,5">
                <Button Content="Добавить материал"
                        Command="{Binding AddMaterialCommand}"
                        Margin="0,0,5,0" />
                <Button Content="Удалить выбранный материал"
                        Command="{Binding RemoveMaterialCommand}"
                        IsEnabled="{Binding SelectedMaterial, Converter={StaticResource NullToBool}}" />                
            </UniformGrid>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Materials}"
                     SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                     BorderThickness="1"
                     BorderBrush="Gray"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MinHeight="150"
                     MaxHeight="400">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <views:MaterialView />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Expander>
</UserControl>